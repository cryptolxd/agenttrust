# 链上读数据 RPC（推荐付费归档节点，公共 RPC 的 getLogs 易限流）
BSC_RPC_URL=

# 部署后的 AgentReputationHub 合约地址（部署前可留空，前端会提示）
NEXT_PUBLIC_HUB_ADDRESS=

# ERC-8004 官方注册表（BSC 主网默认值已内置，测试网需覆盖）
NEXT_PUBLIC_IDENTITY_REGISTRY=0xfA09B3397fAC75424422C4D28b1729E3D4f659D7
NEXT_PUBLIC_REPUTATION_REGISTRY=0x17860530385Bdde7992c4Da71B9ec7791E474C08
NEXT_PUBLIC_AGENT_ID_CONTRACT=0x60b9262456de011f7d15a54cdd8c48baaa8b022f

# 索引器 MySQL（排行榜数据源；不配置时自动回退为实时扫链）
DATABASE_URL=mysql://user:password@127.0.0.1:3306/agent_trust

# 扫链起始区块（Hub 合约部署区块）
START_BLOCK=0
